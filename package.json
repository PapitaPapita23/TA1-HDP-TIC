{
  "name": "novatech-portal-pedidos",
  "version": "1.0.0",
  "description": "PoC TA1 - NovaTech S.A.C. | Portal de Pedidos con CI/CD, contenedores y pruebas automatizadas",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "build": "node scripts/build.js"
  },
  "keywords": ["novatech", "utp", "ci-cd", "devops", "poc"],
  "author": "Equipo NovaTech - TA1 Herramientas de Desarrollo Profesional (UTP)",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coveragePathIgnorePatterns": ["src/server.js"]
  }
}
